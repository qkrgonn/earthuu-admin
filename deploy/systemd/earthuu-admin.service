[Unit]
Description=Earthuu Admin Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/earthuu-admin/deploy
ExecStart=/usr/bin/docker compose --env-file .env.production up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.production down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
